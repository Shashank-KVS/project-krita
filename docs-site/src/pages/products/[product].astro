---
import Base from '../../layouts/Base.astro';import MappingStudio from '../../components/MappingStudio.astro';import GraphExplorer from '../../components/GraphExplorer.astro';import DomainSwitcher from '../../components/DomainSwitcher.astro';
export function getStaticPaths(){return ['pulse','ledger'].map(product=>({params:{product}}))}
const pulse=Astro.params.product==='pulse';
---
<Base title={pulse?'Krita Pulse':'Krita Ledger'}><div class="container"><header class="pagehead"><div class="eyebrow">Krita products · {pulse?'Synthetic demonstration':'Planned domain validation'}</div><h1>{pulse?'Krita Pulse':'Krita Ledger'}</h1><p class="lead">{pulse?'Healthcare operational intelligence through a governed patient–encounter ontology.':'Banking relationship intelligence across customers, accounts, transactions and risk signals.'}</p></header><DomainSwitcher/>{pulse?<div class="content"><h2>Source CSV · entirely synthetic</h2><pre>{`patient_no,visit_id,visit_date,doctor_id,facility_id,diagnosis_code
P001,V100,2026-01-10,D01,F01,DX001
P002,V101,2026-01-11,D02,F01,DX002
P001,V102,2026-02-04,D02,F02,DX001`}</pre><div class="grid3"><div class="card"><span class="pill">Illustrative</span><h3>2 patients</h3></div><div class="card"><span class="pill">Illustrative</span><h3>3 encounters</h3></div><div class="card"><span class="pill">Illustrative</span><h3>3 relationships</h3></div></div><h2>Interactive mapping</h2><MappingStudio/><h2>Relationship exploration</h2><GraphExplorer/><div class="notice">D01/D02, F01/F02, and DX001/DX002 are unresolved references. The CSV does not establish provider names, facility attributes, or diagnosis descriptions.</div></div>:<div class="content"><h2>Proposed banking ontology</h2><div class="flowsteps"><span class="step">Customer</span><span class="step">Account</span><span class="step">Transaction</span><span class="step">Risk signal</span></div><p>This second domain will test whether the same Krita Core can ingest banking records and support governed investigations by changing domain configuration, rather than core engine code.</p><div class="notice">Ledger is planned. No bank connectors, live financial data, or compliance decisions are implemented.</div></div>}</div></Base>
