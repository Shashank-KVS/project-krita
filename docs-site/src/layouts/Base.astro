
---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Overview',
  description = 'Krita — governed enterprise intelligence, from disconnected data to explainable action.'
} = Astro.props;

const b = import.meta.env.BASE_URL;

const nav = [
  ['Overview', ''],
  ['The vision', 'vision'],
  ['Architecture', 'architecture'],
  ['Data lifecycle', 'data-lifecycle'],
  ['Ontology', 'ontology'],
  ['AI intelligence', 'intelligence'],
  ['Security', 'security'],
  ['Krita Pulse', 'products/pulse'],
  ['Krita Ledger', 'products/ledger'],
  ['Product studio', 'product-preview'],
  ['Developers', 'developers'],
  ['Roadmap', 'roadmap']
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8f6" />
    <title>{title} — Krita</title>
  </head>

  <body>
    <div class="announcement">
      <span class="announce-dot"></span>
      PROJECT KRITA
      <span class="announce-sep">/</span>
      INTERNAL PRODUCT VISION
      <span class="announcement-right">
        Concept prototype · Synthetic data only
      </span>
    </div>

    <header class="site-header">
      <a class="brand" href={b} aria-label="Krita home">
        <span class="brand-symbol">k<span>.</span></span>
        <span>krita<span class="brand-reg">®</span></span>
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href={b}>Overview</a>
        <a href={b + 'architecture/'}>Platform</a>
        <a href={b + 'products/pulse/'}>Pulse</a>
        <a href={b + 'products/ledger/'}>Ledger</a>
        <a href={b + 'product-preview/'}>Studio</a>
      </nav>

      <div class="header-actions">
        <a class="header-cta" href={b + 'architecture/'}>
          Explore the architecture <span>↗</span>
        </a>

        <button
          class="menu-toggle"
          type="button"
          aria-label="Toggle navigation"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <nav
      class="mobile-nav"
      id="mobile-nav"
      aria-label="Mobile navigation"
      hidden
    >
      {nav.map(([label, path]) => (
        <a href={b + path + (path ? '/' : '')}>
          {label} <span>↗</span>
        </a>
      ))}
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href={b}>
          <span class="brand-symbol">k<span>.</span></span>
          <span>krita</span>
        </a>
        <p>Intelligence, with structure.</p>
      </div>

      <div class="footer-links">
        <div>
          <strong>Discover</strong>
          {nav.slice(0, 6).map(([label, path]) => (
            <a href={b + path + (path ? '/' : '')}>{label}</a>
          ))}
        </div>

        <div>
          <strong>Build & govern</strong>
          {nav.slice(6).map(([label, path]) => (
            <a href={b + path + (path ? '/' : '')}>{label}</a>
          ))}
        </div>
      </div>

      <div class="footer-bottom">
        © 2026 Krita · Confidential internal concept ·
        No live enterprise services or real customer records.
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const mobile = document.querySelector<HTMLElement>('.mobile-nav');

      function closeMobileMenu() {
        if (mobile) mobile.hidden = true;
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('nav-open');
      }

      toggle?.addEventListener('click', () => {
        const opened = toggle.getAttribute('aria-expanded') === 'true';

        toggle.setAttribute('aria-expanded', String(!opened));

        if (mobile) {
          mobile.hidden = opened;
        }

        document.body.classList.toggle('nav-open', !opened);
      });

      document.querySelectorAll<HTMLAnchorElement>('.mobile-nav a')
        .forEach((link) => {
          link.addEventListener('click', closeMobileMenu);
        });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMobileMenu();
        }
      });

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08 }
        );

        document.querySelectorAll<HTMLElement>('.reveal')
          .forEach((element) => observer.observe(element));
      } else {
        document.querySelectorAll<HTMLElement>('.reveal')
          .forEach((element) => element.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
