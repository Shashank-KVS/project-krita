<div class="panel" id="mapping-studio"><div class="eyebrow">Interactive concept · Browser-only</div><h3>CSV → Ontology mapping studio</h3><p class="muted">Change mappings and export a proposed JSON configuration. No files are uploaded or persisted.</p><div id="mapping-fields"></div><div class="actions"><button class="btn primary" id="mapping-export">Export mapping JSON ↓</button><button class="btn" id="mapping-reset">Reset defaults</button></div><p class="mini" id="mapping-feedback" aria-live="polite"></p></div>
<script>
const defaults:Record<string,string>={patient_no:'Patient.patient_id',visit_id:'Encounter.encounter_id',visit_date:'Encounter.encounter_date',doctor_id:'Encounter.provider_id',facility_id:'Encounter.facility_id',diagnosis_code:'Encounter.diagnosis_code'};
const options=['Ignore',...Object.values(defaults)];
const mount=document.getElementById('mapping-fields')!;
function render(){mount.replaceChildren();for(const [column,target] of Object.entries(defaults)){const line=document.createElement('label');line.className='field';const name=document.createElement('span');name.textContent=column;const select=document.createElement('select');select.setAttribute('aria-label',`Target for ${column}`);for(const opt of options){const o=document.createElement('option');o.value=opt;o.textContent=opt;o.selected=opt===target;select.append(o)}select.dataset.column=column;line.append(name,select);mount.append(line)}}
render();document.getElementById('mapping-reset')?.addEventListener('click',render);
document.getElementById('mapping-export')?.addEventListener('click',()=>{const mapping=Object.fromEntries([...mount.querySelectorAll('select')].map(s=>[s.dataset.column,s.value]));const payload={workspace:'ws_healthcare_001',domain:'healthcare',ontology_version:1,status:'CONCEPT_NOT_APPROVED',mapping};const url=URL.createObjectURL(new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='krita-mapping-concept.json';a.click();URL.revokeObjectURL(url);document.getElementById('mapping-feedback')!.textContent='Concept mapping exported locally. Not validated or approved.'});
</script>
