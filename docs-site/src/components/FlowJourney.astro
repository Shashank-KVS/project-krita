---
const steps=[{number:'01',title:'Connect',tag:'SOURCE SYSTEMS',desc:'Bring together the records you already have.',detail:'CSV files, SQL systems, APIs and documents are profiled and onboarded through governed connectors.',input:'SQL · CSV · API · Documents',output:'Profiled source data',icon:'⌁'},{number:'02',title:'Understand',tag:'SEMANTIC LAYER',desc:'Give every record a shared business meaning.',detail:'A versioned ontology defines business objects, relationships, constraints and approved mappings.',input:'Profiled source data',output:'Canonical business objects',icon:'◇'},{number:'03',title:'Connect the dots',tag:'RELATIONSHIP INTELLIGENCE',desc:'Turn isolated facts into a connected picture.',detail:'Authorized entities and relationships are projected into a navigable graph, with lineage back to their sources.',input:'Canonical objects',output:'Governed relationship graph',icon:'✳'},{number:'04',title:'Investigate',tag:'AI INTELLIGENCE',desc:'Ask questions. Follow the evidence.',detail:'An agent plans with approved tools. Trusted application services enforce policy and return traceable evidence.',input:'Authorized graph + evidence',output:'Grounded answers',icon:'✦'},{number:'05',title:'Act',tag:'GOVERNED ACTIONS',desc:'Move from insight to responsible action.',detail:'Consequential actions follow authorization, human approval, revalidation and audit trails.',input:'Proposed action',output:'Approved, audited outcome',icon:'↗'}];
---
<section class="journey" id="how-it-works"><div class="section-topline"><span class="eyebrow">THE KRITA METHOD</span><span class="section-index">01 — 05 / INTERACTIVE WALKTHROUGH</span></div><div class="section-intro reveal"><h2>Five steps.<br/><em>One connected picture.</em></h2><p>Follow a piece of enterprise data as Krita transforms it into governed intelligence. Select any step to explore the flow.</p></div><div class="journey-layout"><div class="journey-list" role="tablist" aria-label="Krita workflow steps">{steps.map((s,i)=><button class:list={['journey-step',{selected:i===0}]} role="tab" aria-selected={i===0?'true':'false'} aria-controls="journey-detail" data-step={i}><span class="journey-num">{s.number}</span><span class="journey-step-content"><span class="journey-step-title">{s.title}</span><span class="journey-step-desc">{s.desc}</span></span><span class="journey-arrow">↗</span></button>)}</div><div class="journey-display" id="journey-detail" role="tabpanel"><div class="journey-display-top"><span id="flow-tag">SOURCE SYSTEMS</span><span>KRITA / FLOW ENGINE</span></div><div class="journey-visual"><div class="flow-orbit orbit-1"></div><div class="flow-orbit orbit-2"></div><div class="flow-orbit orbit-3"></div><div class="flow-center" id="flow-icon">⌁</div><div class="flow-satellite sat-one"></div><div class="flow-satellite sat-two"></div><div class="flow-satellite sat-three"></div></div><div class="journey-display-bottom"><span class="flow-current" id="flow-number">STEP 01 / 05</span><h3 id="flow-title">Connect</h3><p id="flow-detail">Bring together CSV, SQL, APIs and documents through governed connectors.</p><div class="flow-io"><div><small>INPUT</small><strong id="flow-input">SQL · CSV · API · Documents</strong></div><span class="io-arrow">→</span><div><small>OUTPUT</small><strong id="flow-output">Profiled source data</strong></div></div><div class="flow-controls"><button id="flow-prev" aria-label="Previous step">←</button><span id="flow-progress">01 / 05</span><button id="flow-next" aria-label="Next step">→</button></div></div></div></div></section>
<script define:vars={{steps}}>const buttons=[...document.querySelectorAll('.journey-step')];let current=0;function showStep(n){current=(n+steps.length)%steps.length;const s=steps[current];buttons.forEach((b,i)=>{b.classList.toggle('selected',i===current);b.setAttribute('aria-selected',String(i===current))});for(const [id,value] of Object.entries({'flow-tag':s.tag,'flow-icon':s.icon,'flow-number':`STEP ${s.number} / 05`,'flow-title':s.title,'flow-detail':s.detail,'flow-input':s.input,'flow-output':s.output,'flow-progress':`${s.number} / 05`}))document.getElementById(id).textContent=value;document.querySelector('.journey-display')?.setAttribute('data-active-step',String(current));}buttons.forEach((b,i)=>b.addEventListener('click',()=>showStep(i)));document.getElementById('flow-prev')?.addEventListener('click',()=>showStep(current-1));document.getElementById('flow-next')?.addEventListener('click',()=>showStep(current+1));</script>
