<div class="panel"><div class="eyebrow">Configuration-driven design · Concept</div><h3>One core. Multiple domain packages.</h3><div class="actions"><button class="btn primary" id="domain-pulse">Pulse · Healthcare</button><button class="btn" id="domain-ledger">Ledger · Banking</button></div><div id="domain-detail" class="notice">Pulse ontology: Patient → Encounter → Provider / Facility / Diagnosis. Source: synthetic encounter CSV. First planned demonstration.</div></div>
<script>
const pulse=document.getElementById('domain-pulse')!,ledger=document.getElementById('domain-ledger')!,detail=document.getElementById('domain-detail')!;function set(which:'pulse'|'ledger'){detail.textContent=which==='pulse'?'Pulse ontology: Patient → Encounter → Provider / Facility / Diagnosis. Source: synthetic encounter CSV. First planned demonstration.':'Ledger ontology: Customer → Account → Transaction → Risk signal. Planned second-domain validation; no banking integration exists.';pulse.classList.toggle('primary',which==='pulse');ledger.classList.toggle('primary',which==='ledger')}pulse.addEventListener('click',()=>set('pulse'));ledger.addEventListener('click',()=>set('ledger'));
</script>
