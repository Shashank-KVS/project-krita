<div class="panel"><div class="eyebrow">Synthetic dataset · Interactive concept</div><h3>Patient–Encounter relationship explorer</h3><p class="muted">Select a node to inspect source-backed IDs. Provider, facility, and diagnosis references are unresolved.</p><svg viewBox="0 0 650 280" role="img" aria-label="Patient P001 connects to encounters V100 and V102; P002 connects to V101" style="width:100%;max-width:750px"><line class="graphline" x1="155" y1="90" x2="375" y2="50"/><line class="graphline" x1="155" y1="90" x2="375" y2="145"/><line class="graphline" x1="155" y1="225" x2="375" y2="240"/>{[['P001',155,90],['P002',155,225],['V100',375,50],['V102',375,145],['V101',375,240]].map(([id,x,y])=><g class="node" data-id={id} tabindex="0" role="button" aria-label={`Inspect ${id}`}><circle cx={x} cy={y} r="38"/><text x={x} y={Number(y)+5}>{id}</text></g>)}</svg><div id="graph-detail" class="notice" aria-live="polite">Select a patient or encounter to inspect its synthetic source record.</div></div>
<script>
const records:Record<string,string>={P001:'Patient P001 · Encounters V100 (2026-01-10), V102 (2026-02-04).',P002:'Patient P002 · Encounter V101 (2026-01-11).',V100:'Encounter V100 · Patient P001 · 2026-01-10 · Provider D01 (unresolved) · Facility F01 (unresolved) · DX001 (unresolved).',V101:'Encounter V101 · Patient P002 · 2026-01-11 · Provider D02 (unresolved) · Facility F01 (unresolved) · DX002 (unresolved).',V102:'Encounter V102 · Patient P001 · 2026-02-04 · Provider D02 (unresolved) · Facility F02 (unresolved) · DX001 (unresolved).'};
for(const node of document.querySelectorAll<SVGGElement>('.node')){const show=()=>document.getElementById('graph-detail')!.textContent=records[node.dataset.id||''];node.addEventListener('click',show);node.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();show()}})}
</script>
